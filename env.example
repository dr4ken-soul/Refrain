# Refrain environment template.
# Copy the relevant block into apps/web/.env.local, apps/api/.env and cre/.env.
# Real values never enter version control.

# Web app (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_REFRAIN_LEDGER_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111

# API and collector (apps/api, apps/collector)
DATABASE_URL=postgresql://user:password@localhost:5432/refrain
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/absolute/path/outside/repo/refrain.session
CRE_BEARER_SECRET=
OPERATOR_SECRET=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
PRICE_FETCH_TIMEOUT_SECONDS=10

# CRE project (cre)
# The simulation wallet is Sepolia-only and faucet-funded. Never use a wallet that holds mainnet assets.
CRE_ETH_PRIVATE_KEY=
API_BASE_URL=http://localhost:8000
SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
REFRAIN_LEDGER_ADDRESS=
