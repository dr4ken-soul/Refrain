# Copy this template once to the repository-root .env and fill in local values.
# The root .env is the only credentials file. Do not copy secrets into app folders.

# Browser-visible settings. Keep all credentials out of NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SEPOLIA_RPC_URL=
NEXT_PUBLIC_REFRAIN_LEDGER_ADDRESS=0x03d2011c624016F7A5A9D02318c2fdba31c63278
NEXT_PUBLIC_CHAIN_ID=11155111

# API and collector
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/refrain
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./.local/telegram/refrain.session
CRE_BEARER_SECRET=
OPERATOR_SECRET=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
PRICE_FETCH_TIMEOUT_SECONDS=10

# CRE simulation, Sepolia only
CRE_ETH_PRIVATE_KEY=
API_BASE_URL=http://127.0.0.1:8000
SEPOLIA_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=
REFRAIN_LEDGER_ADDRESS=0x03d2011c624016F7A5A9D02318c2fdba31c63278
REFRAIN_INDEXER_START_BLOCK=12026631
REFRAIN_INDEXER_CONFIRMATIONS=5
REFRAIN_INDEXER_BATCH_BLOCKS=500
REFRAIN_INDEXER_POLL_SECONDS=30
